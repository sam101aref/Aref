      "key": "level.0_1.title",
      "en": "First Draw",
      "fa": "نخستین کمان"
    },
    {
      "key": "level.0_1.intro",
      "en": "Turanian scouts are near the village. Show them what a bowstring can do.",
      "fa": "دیده‌بان‌های تورانی نزدیک روستا هستند. نشانشان بده زه کمان چه می‌کند."
    },
    {
      "key": "level.0_1.hint",
      "en": "Touch anywhere, pull back and release to shoot.",
      "fa": "هر جای صفحه را لمس کن، به عقب بکش و رها کن."
    },
    {
      "key": "level.0_2.title",
      "en": "Aim High",
      "fa": "نشانه به سر"
    },
    {
      "key": "level.0_2.intro",
      "en": "This scout is tougher. Aim for the head.",
      "fa": "این دیده‌بان سرسخت‌تر است. سرش را نشانه بگیر."
    },
    {
      "key": "level.0_2.hint",
      "en": "A shot to the head ends the fight.",
      "fa": "تیر به سر، کار را تمام می‌کند."
    },
    {
      "key": "level.0_3.title",
      "en": "The Far Hill",
      "fa": "تپهٔ دور"
    },
    {
      "key": "level.0_3.intro",
      "en": "He shoots from far away. Draw harder.",
      "fa": "از دور تیر می‌اندازد. کمان را محکم‌تر بکش."
    },
    {
      "key": "level.0_3.hint",
      "en": "Pull farther for more power.",
      "fa": "هرچه بیشتر بکشی، تیر دورتر می‌رود."
    },
    {
      "key": "level.0_4.title",
      "en": "High Ground",
      "fa": "بلندی"
    },
    {
      "key": "level.0_4.intro",
      "en": "An archer on the rocks. Your arrow must climb.",
      "fa": "کمانداری روی صخره‌ها. تیرت باید اوج بگیرد."
    },

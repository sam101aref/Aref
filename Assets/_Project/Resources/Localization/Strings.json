    {"key": "item.bow.wood.name", "en": "Wooden Bow", "fa": "کمان چوبی"},
    {"key": "item.bow.wood.desc", "en": "The plain bow Arash brought from the village.", "fa": "کمان ساده‌ای که آرش از روستا آورده."},
    {"key": "item.bow.horn.name", "en": "Horn Bow", "fa": "کمان شاخی"},
    {"key": "item.bow.horn.desc", "en": "Horn and sinew: flies farther and faster.", "fa": "از شاخ و پی؛ تیرش دورتر و تندتر می‌رود."},
    {"key": "item.bow.fire.name", "en": "Bow of Azar", "fa": "کمان آذر"},
    {"key": "item.bow.fire.desc", "en": "Its arrows burn foes and set wooden cover alight.", "fa": "تیرهایش دشمن را می‌سوزانند و سنگر چوبی را شعله‌ور می‌کنند."},
    {"key": "item.bow.haoma.name", "en": "Haoma Bow", "fa": "کمان هوم"},
    {"key": "item.bow.haoma.desc", "en": "Every hit on a foe gives Arash back a little life.", "fa": "هر تیری که به دشمن بخورد، کمی جان به آرش برمی‌گرداند."},
    {"key": "item.bow.triple.name", "en": "Three-Feather Bow", "fa": "کمان سه‌پر"},
    {"key": "item.bow.triple.desc", "en": "Looses three arrows at once.", "fa": "با هر کشیدن، سه تیر با هم رها می‌کند."},
    {"key": "item.bow.frost.name", "en": "Tishtrya's Bow", "fa": "کمان تیشتر"},
    {"key": "item.bow.frost.desc", "en": "Rain-soaked arrows of the rain god: the struck foe draws slowly.", "fa": "تیرهای باران‌خوردهٔ ایزد باران؛ دشمنِ زخمی کند کمان می‌کشد."},
    {"key": "item.bow.piercing.name", "en": "Piercing Bow", "fa": "کمان شکافنده"},
    {"key": "item.bow.piercing.desc", "en": "Its arrow goes through shields and several foes.", "fa": "تیرش از سپر و از چند دشمن می‌گذرد."},
    {"key": "item.bow.simurgh.name", "en": "Simurgh Bow", "fa": "کمان سیمرغ"},
    {"key": "item.bow.simurgh.desc", "en": "A Simurgh feather guides each arrow to the nearest foe.", "fa": "پر سیمرغ هر تیر را به سوی نزدیک‌ترین دشمن می‌برد."},
    {"key": "item.bow.thunder.name", "en": "Thunder Bow", "fa": "کمان آذرخش"},
    {"key": "item.bow.thunder.desc", "en": "Lightning leaps from each hit to the next foe.", "fa": "از هر برخورد، آذرخشی به دشمن بعدی می‌جهد."},
    {"key": "item.bow.arash.name", "en": "The Bow of Arash", "fa": "کمان آرش"},
    {"key": "item.bow.arash.desc", "en": "The bow of the hero: swift, mighty, with a golden trail.", "fa": "کمان پهلوان؛ تند و پرزور، با ردی زرین."},
    {"key": "item.armor.leather.name", "en": "Leather Armour", "fa": "زره چرمی"},
    {"key": "item.armor.leather.desc", "en": "Light and simple.", "fa": "سبک و ساده."},
    {"key": "item.armor.scale.name", "en": "Scale Armour", "fa": "زره فلس‌دار"},
    {"key": "item.armor.scale.desc", "en": "Iron scales over the chest.", "fa": "فلس‌های آهنین بر سینه."},
    {"key": "item.armor.immortal.name", "en": "Armour of the Immortals", "fa": "زرهِ جاویدان"},
    {"key": "item.armor.immortal.desc", "en": "Worn by the kings' chosen guard.", "fa": "زرهِ سپاه برگزیدهٔ شاهان."},
    {"key": "item.helmet.felt.name", "en": "Felt Cap", "fa": "کلاه نمدی"},
    {"key": "item.helmet.felt.desc", "en": "Softens arrows to the head.", "fa": "از زخم تیر بر سر می‌کاهد."},
    {"key": "item.helmet.iron.name", "en": "Iron Helm", "fa": "خود آهنین"},
    {"key": "item.helmet.iron.desc", "en": "A riveted iron helm.", "fa": "خودی آهنین و پرچ‌شده."},
    {"key": "item.helmet.gold.name", "en": "Golden Helm", "fa": "خود زرین"},
    {"key": "item.helmet.gold.desc", "en": "The helm of champions, crested in red.", "fa": "خود پهلوانان، با کاکلی سرخ."},
    {"key": "item.shield.wood.name", "en": "Wooden Shield", "fa": "سپر چوبی"},
    {"key": "item.shield.wood.desc", "en": "Stands before Arash and catches arrows until it breaks.", "fa": "جلوی آرش می‌ایستد و تیرها را به جان می‌خرد تا بشکند."},
    {"key": "item.shield.bronze.name", "en": "Bronze Shield", "fa": "سپر مفرغی"},
    {"key": "item.shield.bronze.desc", "en": "Bronze-bound, much harder to break.", "fa": "با روکش مفرغ؛ بسیار دیرتر می‌شکند."},
    {"key": "item.shield.simurgh.name", "en": "Simurgh Shield", "fa": "سپر سیمرغ"},
    {"key": "item.shield.simurgh.desc", "en": "Painted with the Simurgh; almost unbreakable.", "fa": "با نقش سیمرغ؛ کم‌وبیش نشکن."},
    {"key": "item.quiver.1.name", "en": "Leather Quiver", "fa": "ترکش چرمی"},
    {"key": "item.quiver.1.desc", "en": "More arrows for every bow.", "fa": "تیر بیشتر برای همهٔ کمان‌ها."},
    {"key": "item.quiver.2.name", "en": "Large Quiver", "fa": "ترکش بزرگ"},
    {"key": "item.quiver.2.desc", "en": "Many more arrows for every bow.", "fa": "تیرهای خیلی بیشتر برای همهٔ کمان‌ها."},
    {"key": "item.quiver.3.name", "en": "Champion's Quiver", "fa": "ترکش پهلوانی"},
    {"key": "item.quiver.3.desc", "en": "The quiver of a hero who never runs dry.", "fa": "ترکش پهلوانی که تیرش تمام نمی‌شود."},
    {"key": "item.slot.2.name", "en": "Second Bow Slot", "fa": "جایگاه دوم کمان"},
    {"key": "item.slot.2.desc", "en": "Carry another bow and switch to it in battle.", "fa": "یک کمان دیگر همراه آرش؛ وسط نبرد عوضش کن."},
    {"key": "item.slot.3.name", "en": "Third Bow Slot", "fa": "جایگاه سوم کمان"},
    {"key": "item.slot.3.desc", "en": "Carry three bows into battle.", "fa": "سه کمان همراه آرش در نبرد."},
    {"key": "item.outfit.teal.name", "en": "Turquoise Garb", "fa": "جامهٔ فیروزه‌ای"},
    {"key": "item.outfit.teal.desc", "en": "Arash's own colours, from the border village.", "fa": "رنگ همیشگی آرش، از روستای مرزی."},
    {"key": "item.outfit.lapis.name", "en": "Lapis Garb", "fa": "جامهٔ لاجوردی"},
    {"key": "item.outfit.lapis.desc", "en": "Deep blue with a golden cape.", "fa": "آبی ژرف با شنلی زرین."},
    {"key": "item.outfit.saffron.name", "en": "Saffron Garb", "fa": "جامهٔ زعفرانی"},
    {"key": "item.outfit.saffron.desc", "en": "The gold of the harvest.", "fa": "زرینِ هنگام خرمن."},
    {"key": "item.outfit.crimson.name", "en": "Crimson Garb", "fa": "جامهٔ سرخ"},
    {"key": "item.outfit.crimson.desc", "en": "The red of Manuchehr's archers.", "fa": "سرخِ کمانداران منوچهر."},
    {"key": "item.outfit.emerald.name", "en": "Emerald Garb", "fa": "جامهٔ زمردین"},
    {"key": "item.outfit.emerald.desc", "en": "The green of the forests of Tabarestan.", "fa": "سبزِ جنگل‌های تبرستان."},
    {"key": "item.outfit.night.name", "en": "Night Garb", "fa": "جامهٔ شب"},
    {"key": "item.outfit.night.desc", "en": "For the silent night missions.", "fa": "برای مأموریت‌های خاموش شبانه."},
    {"key": "item.outfit.royal.name", "en": "Royal Garb", "fa": "جامهٔ شاهانه"},
    {"key": "item.outfit.royal.desc", "en": "Purple and gold, fit for the king's guard.", "fa": "ارغوانی و زر، شایستهٔ پاسداران شاه."},
    {"key": "item.outfit.immortal.name", "en": "White of the Immortals", "fa": "سپیدِ جاویدان"},
    {"key": "item.outfit.immortal.desc", "en": "Worn by those who stood on the summit.", "fa": "جامهٔ آنان که بر قله ایستادند."}
  ]
}
